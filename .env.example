# Copy this file to .env and fill in the required settings.
# Optional values may be omitted or left empty when using Docker Compose.

# -----------------------------------------------------------------------------
# Required settings
# -----------------------------------------------------------------------------

# Telegram bot token from @BotFather.
BOT_TOKEN=

# OpenAI-compatible API base URL, e.g. https://your-provider.example/v1.
API_BASE=

# Model name supported by your API provider.
MODEL=

# MCP servers as a JSON object; at least one server must provide tools.
# This URL uses the bundled Docker service. For a host Python process,
# replace it with a reachable MCP URL.
MCP_SERVERS={"searxng":{"url":"http://mcp-search:3000/mcp"}}

# -----------------------------------------------------------------------------
# API authentication and proxies (optional)
# -----------------------------------------------------------------------------

# API key; required only if your provider requires authentication.
API_KEY=

# Proxy URL for the LLM API, e.g. http://user:password@host:port.
PROXY=

# Proxy URL for Telegram, e.g. socks5://user:password@host:port.
TG_PROXY=

# -----------------------------------------------------------------------------
# Bot settings (optional; defaults shown)
# -----------------------------------------------------------------------------

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Include conversation history and tool calls in Telegram replies: true or false.
CHECK_HISTORY=false
